{
  "name": "undaunted-launcher",
  "productName": "Undaunted Launcher",
  "version": "0.0.6",
  "description": "A Launcher for the Undaunted Project",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:release": "tauri build --bundles nsis",
    "build:release:fast": "set \"CARGO_PROFILE_RELEASE_LTO=false\" && set \"CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16\" && set \"CARGO_PROFILE_RELEASE_PACKAGE_UNDAUNTED_LAUNCHER_OPT_LEVEL=0\" && tauri build --bundles nsis",
    "check": "pnpm build",
    "tauri": "tauri"
  },
  "author": {
    "name": "Gregory Morford",
    "email": "realsystemdev@gmail.com"
  },
  "contributors": [
    {
      "name": "EisigesEis",
      "url": "https://github.com/EisigesEis/"
    }
  ],
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.1",
    "@tauri-apps/plugin-dialog": "^2.7.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "26.4.0",
    "typescript": "6.0.3",
    "vite": "^8.1.3"
  }
}
